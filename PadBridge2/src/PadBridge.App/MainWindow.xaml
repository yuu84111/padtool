<Window x:Class="PadBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PadBridge"
        Height="720"
        Width="820"
        MinHeight="660"
        MinWidth="760"
        Background="#1B1D23"
        Foreground="#F2F4F8"
        WindowStartupLocation="CenterScreen"
        Closed="OnClosed">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="#2F3542"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#4B5568"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="BindBtn" TargetType="Button">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="4,2"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Background" Value="#353B48"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#4B5568"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel>
            <TextBlock FontSize="22" FontWeight="SemiBold" Text="PadBridge"/>
            <TextBlock Opacity="0.8" Text="キーボード / マウスを仮想 Xbox コントローラーへ変換します。F8 で変換の開始・停止。"/>
            <TextBlock x:Name="StatusText" Margin="0,8,0,12" Text="ViGEmBus を確認しています…"/>
        </StackPanel>

        <!-- Toolbar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="ConnectButton" Content="仮想パッドを接続" Click="OnConnectClick"/>
            <Button x:Name="StartButton" Content="変換開始 (F8)" Click="OnStartClick" IsEnabled="False"/>
            <Button x:Name="StopButton" Content="停止" Click="OnStopClick" IsEnabled="False"/>
            <Button x:Name="SaveButton" Content="💾 保存" Click="OnSaveClick"/>
            <Button x:Name="LoadButton" Content="📂 読み込み" Click="OnLoadClick"/>
        </StackPanel>

        <!-- TabControl -->
        <TabControl Grid.Row="2" Background="#22252C" Foreground="#F2F4F8" BorderBrush="#3A3F4B">
            <!-- Tab 1: 設定 -->
            <TabItem Header="  設定  " Foreground="#F2F4F8">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,18,0">
                        <TextBlock FontWeight="SemiBold" Text="マウス → 右スティック"/>
                        <TextBlock x:Name="SensitivityLabel" Text="感度"/>
                        <Slider x:Name="SensitivitySlider" Minimum="0.001" Maximum="0.100" Value="0.030"
                                TickFrequency="0.001" IsSnapToTickEnabled="False" ValueChanged="OnSettingChanged"/>
                        <TextBlock x:Name="CurveLabel" Text="レスポンスカーブ"/>
                        <Slider x:Name="CurveSlider" Minimum="0.5" Maximum="3.0" Value="1.4" ValueChanged="OnSettingChanged"/>
                        <TextBlock x:Name="DeadzoneLabel" Text="アンチデッドゾーン"/>
                        <Slider x:Name="DeadzoneSlider" Minimum="0" Maximum="0.50" Value="0.18" ValueChanged="OnSettingChanged"/>
                        <TextBlock x:Name="SmoothLabel" Text="スムージング"/>
                        <Slider x:Name="SmoothSlider" Minimum="0.001" Maximum="0.12" Value="0.018" ValueChanged="OnSettingChanged"/>
                        <TextBlock x:Name="RampLabel" Text="WASD ランプ"/>
                        <Slider x:Name="RampSlider" Minimum="0.001" Maximum="0.12" Value="0.035" ValueChanged="OnSettingChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock FontWeight="SemiBold" Text="ライブ入力"/>
                        <TextBlock x:Name="HzText" Text="ポーリング: -- Hz"/>
                        <TextBlock Text="左スティック"/>
                        <ProgressBar x:Name="LeftXBar" Height="10" Minimum="-1" Maximum="1" Value="0" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="LeftYBar" Height="10" Minimum="-1" Maximum="1" Value="0" Margin="0,0,0,12"/>
                        <TextBlock Text="右スティック"/>
                        <ProgressBar x:Name="RightXBar" Height="10" Minimum="-1" Maximum="1" Value="0" Margin="0,0,0,8"/>
                        <ProgressBar x:Name="RightYBar" Height="10" Minimum="-1" Maximum="1" Value="0" Margin="0,0,0,12"/>
                        <TextBlock x:Name="ButtonsText" Text="ボタン: なし" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Tab 2: キー割り当て -->
            <TabItem Header="  キー割り当て  " Foreground="#F2F4F8">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,0,8"
                                   Text="各ボタンの「割り当て」を押してからキーまたはマウスボタンを入力してください。「解除」で割り当てを削除します。"/>

                        <TextBlock FontWeight="SemiBold" Margin="0,10,0,6" Text="── フェイスボタン ──"/>
                        <UniformGrid Columns="3" x:Name="FacePanel"/>

                        <TextBlock FontWeight="SemiBold" Margin="0,10,0,6" Text="── ショルダー / トリガー ──"/>
                        <UniformGrid Columns="3" x:Name="ShoulderPanel"/>

                        <TextBlock FontWeight="SemiBold" Margin="0,10,0,6" Text="── スティック押込 / メニュー ──"/>
                        <UniformGrid Columns="3" x:Name="ThumbMenuPanel"/>

                        <TextBlock FontWeight="SemiBold" Margin="0,10,0,6" Text="── D-Pad ──"/>
                        <UniformGrid Columns="3" x:Name="DpadPanel"/>

                        <TextBlock FontWeight="SemiBold" Margin="0,10,0,6" Text="── 左スティック方向 ──"/>
                        <UniformGrid Columns="3" x:Name="LStickPanel"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="3" Opacity="0.65" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="ゲーム側にパッドだけを見せるため、変換中は割り当て済みのキーとマウス移動を消費します。オフラインのパッド専用タイトル向けです。"/>
    </Grid>
</Window>
